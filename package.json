{
  "name": "solucao-compras",
  "version": "1.1.13",
  "description": "Bolt Compras - Plataforma web de gestão de compras",
  "author": "",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.web.json --composite false",
    "dev": "vite --config vite.web.config.js",
    "build": "vite build --config vite.web.config.js",
    "preview": "vite preview --config vite.web.config.js",
    "test": "vitest run --reporter=verbose --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "vitest": "^3.2.0"
  }
}
